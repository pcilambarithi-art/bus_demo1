# =====================================================================
# Dhanalakshmi College of Engineering Bus Tracker — Environment Config
# Placeholders only. Copy to .env and configure for your environment.
# =====================================================================

# Server Binding
HOST=0.0.0.0
PORT=5000
DEBUG=false

# Database Configuration (SQLite default for local development)
DATABASE_URL=sqlite:///./data/bus_tracker.db
# For PostgreSQL production deployment:
# DATABASE_URL=postgresql://user:password@localhost:5432/dce_bus_db

# Security & Session Secrets
SECRET_KEY=replace_with_a_secure_random_hex_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# GPS & Geofencing Parameters
GPS_JITTER_MAX_SPEED_KMH=150.0
GEOFENCE_STATION_RADIUS_METERS=60
GEOFENCE_APPROACH_RADIUS_METERS=450
GEOFENCE_DESTINATION_RADIUS_METERS=120
GPS_STALE_THRESHOLD_SECONDS=45
GPS_OFFLINE_THRESHOLD_SECONDS=90

# Retention Policy
GPS_HISTORY_RETENTION_DAYS=30
