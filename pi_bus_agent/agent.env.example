# ==============================================================================
# DCE RASPBERRY PI 5 BUS AGENT — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to /etc/dce-bus-agent/agent.env and secure with: sudo chmod 600 /etc/dce-bus-agent/agent.env
# NEVER commit actual production API keys to git!
# ==============================================================================

# 1. Unique Bus & Device Identity
DCE_DEVICE_ID=pi-bus-07
DCE_BUS_ID=bus-07
DCE_ROUTE_ID=route-07
DCE_DEVICE_API_KEY=REPLACE_WITH_UNIQUE_PROVISIONED_DEVICE_KEY

# 2. Central FastAPI Server Endpoint (HTTPS over 4G LTE)
DCE_SERVER_URL=https://transit.dce.edu.in
DCE_VERIFY_TLS=true
DCE_CA_BUNDLE_PATH=

# 3. u-blox NEO-6M (MP510_GPS_V02_WWXL) Hardware UART
# Raspberry Pi 5 GPIO 14 (TXD0 / Pin 8) & GPIO 15 (RXD0 / Pin 10) -> /dev/ttyAMA0
DCE_GPS_PORT=/dev/ttyAMA0
DCE_GPS_BAUD=9600
DCE_GPS_INTERVAL_SEC=2.0

# 4. Persistent SQLite Store-and-Forward Queue
DCE_LOCAL_QUEUE_DB=/var/lib/dce-bus-agent/queue_pi-bus-07.db

# 5. Cabin Speaker & USB Audio DAC (Raspberry Pi 5 has no 3.5mm analog jack)
DCE_AUDIO_DEVICE=plughw:1,0
DCE_AUDIO_CLIPS_DIR=/opt/dce-bus-agent/audio_clips
DCE_ANNOUNCEMENT_COOLDOWN_SEC=180
DCE_GEOFENCE_APPROACHING_M=350.0
DCE_GEOFENCE_ARRIVAL_M=80.0
DCE_GEOFENCE_DEPARTURE_M=135.0

# 6. 4G Cellular Sync & Exponential Backoff
DCE_SYNC_INTERVAL_SEC=3.0
DCE_MAX_BACKOFF_SEC=120.0
DCE_HEARTBEAT_INTERVAL_SEC=30.0
DCE_TEST_MODE=false
