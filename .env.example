# ============================================================================
# DHANALAKSHMI COLLEGE OF ENGINEERING BUS TRACKING & FACE ATTENDANCE SYSTEM
# Environment Configuration Template (.env.example)
# Copy this file to .env and fill in strong secrets. NEVER commit .env to Git!
# ============================================================================

# Server Binding
HOST=0.0.0.0
PORT=5000
DEBUG=false

# Security & Biometric Encryption Secrets (Generate via: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_JWT_SECRET_KEY
FACE_TEMPLATE_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_RANDOM_BIOMETRIC_AES_KEY

# Face Attendance Verification Thresholds
FACE_MATCH_SIMILARITY_THRESHOLD=0.82
FACE_MIN_BRIGHTNESS=35.0
FACE_MAX_BRIGHTNESS=235.0
FACE_MIN_SHARPNESS=12.0
FACE_MIN_LIVENESS_SCORE=0.65

# MySQL 8.x Six-Database Connection URLs (Principle of Least Privilege — Never use root!)
DCE_DB_MODE=mysql
DCE_IDENTITY_DB_URL=mysql+pymysql://dce_identity_user:REPLACE_PASSWORD@127.0.0.1:3306/dce_identity_db?charset=utf8mb4
DCE_STUDENT_DB_URL=mysql+pymysql://dce_student_user:REPLACE_PASSWORD@127.0.0.1:3306/dce_student_db?charset=utf8mb4
DCE_TRACKING_DB_URL=mysql+pymysql://dce_tracking_user:REPLACE_PASSWORD@127.0.0.1:3306/dce_bus_tracking_db?charset=utf8mb4
DCE_ATTENDANCE_DB_URL=mysql+pymysql://dce_attendance_user:REPLACE_PASSWORD@127.0.0.1:3306/dce_attendance_db?charset=utf8mb4
DCE_NOTIFICATIONS_DB_URL=mysql+pymysql://dce_notif_user:REPLACE_PASSWORD@127.0.0.1:3306/dce_notifications_db?charset=utf8mb4
DCE_AUDIT_DB_URL=mysql+pymysql://dce_audit_user:REPLACE_PASSWORD@127.0.0.1:3306/dce_audit_db?charset=utf8mb4

# Real GPS & Geofencing Parameters
GPS_JITTER_MAX_SPEED_KMH=150.0
GEOFENCE_STATION_RADIUS_METERS=60
GEOFENCE_APPROACH_RADIUS_METERS=450
GEOFENCE_DESTINATION_RADIUS_METERS=120
GPS_STALE_THRESHOLD_SECONDS=45
GPS_OFFLINE_THRESHOLD_SECONDS=90
GPS_HISTORY_RETENTION_DAYS=30
